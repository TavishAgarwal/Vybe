{
  "expo": {
    "name": "Vybe",
    "slug": "vybe",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vybeapp",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d0d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.vybe.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Record your challenge entry",
        "NSMicrophoneUsageDescription": "Record audio for your Vybe entry",
        "NSPhotoLibraryUsageDescription": "Pick a video from your gallery",
        "NSPhotoLibraryAddUsageDescription": "Save your Vybe to your camera roll",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "associatedDomains": [
        "applinks:vybe.app"
      ]
    },
    "android": {
      "package": "app.vybe.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0d0d0d"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "vybeapp"
            },
            {
              "scheme": "https",
              "host": "vybe.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0d0d0d",
      "translucent": true
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0d0d",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "your-org"
        }
      ],
      "@sentry/react-native",
      "expo-video"
    ],
    "extra": {
      "EXPO_PUBLIC_API_URL": "https://api.vybe.app",
      "router": {}
    }
  }
}
