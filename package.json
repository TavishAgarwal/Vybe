{
  "name": "vybe",
  "version": "1.0.0",
  "description": "Positive social video platform for weekly talent challenges",
  "main": "node_modules/expo/AppEntry.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TavishAgarwal/vybe.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "social",
    "video",
    "challenges"
  ],
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "lint": "eslint src/ --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prebuild": "expo prebuild --clean",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:all": "eas build --platform all",
    "doctor": "expo-doctor",
    "clean": "rm -rf node_modules .expo dist && npm install"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.13",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.100.9",
    "axios": "^1.16.0",
    "date-fns": "^4.1.0",
    "expo": "~55.0.23",
    "expo-av": "^16.0.8",
    "expo-blur": "~55.0.14",
    "expo-camera": "~55.0.18",
    "expo-constants": "~55.0.16",
    "expo-file-system": "~55.0.19",
    "expo-font": "~55.0.7",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.10",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.15",
    "expo-localization": "~55.0.13",
    "expo-media-library": "~55.0.16",
    "expo-notifications": "~55.0.22",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-video": "~55.0.17",
    "expo-web-browser": "~55.0.15",
    "i18next": "^26.0.4",
    "lottie-react-native": "^7.3.6",
    "lucide-react-native": "^1.7.0",
    "moti": "^0.30.0",
    "nativewind": "^4.2.3",
    "posthog-react-native": "^4.45.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.75.0",
    "react-i18next": "^17.0.2",
    "react-native": "0.83.6",
    "react-native-bottom-sheet": "^1.0.3",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-purchases-ui": "^9.15.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-video": "^6.19.2",
    "react-native-vision-camera": "^5.0.9",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.19",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@react-native-community/eslint-config": "^3.2.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~55.0.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-doctor": "^1.17.12",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.17",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "ffmpeg-kit-react-native",
          "react-native-bottom-sheet",
          "react-native-nitro-image"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "packageManager": "npm@11.7.0",
  "private": true
}
