# Vybe App — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# API
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# WARNING: Never put service_role key here or anywhere in mobile code

# Video / Media (Cloudflare Stream or Mux)
EXPO_PUBLIC_VIDEO_DELIVERY_URL=
EXPO_PUBLIC_CLOUDFLARE_CUSTOMER_CODE=

# Firebase (Push Notifications)
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=

# Analytics (PostHog)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Moderation (server-side only — do NOT put in mobile .env)
# PERSPECTIVE_API_KEY — backend only
# WHISPER_API_KEY — backend only

# App Config
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_MAX_VIDEO_SIZE_MB=100
EXPO_PUBLIC_MAX_VIDEO_DURATION_SECONDS=60
